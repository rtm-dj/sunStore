    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "vite": "^5.3.1",
    "vite-plugin-pages": "^0.33.1",
    "vite-plugin-sitemap": "^0.8.2"
  }
}
